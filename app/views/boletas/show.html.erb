<%# app/views/boletas/show.html.erb %>
<div style="min-height:100vh;background:#F8F9FA">

  <header style="background:#FFFFFF;border-bottom:1px solid #E5E7EB">
    <div style="max-width:1120px;margin:0 auto;padding:12px 24px;box-sizing:border-box;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 24px">
      <%= link_to root_path, style: "display:inline-flex;align-items:center;gap:10px;min-height:44px;text-decoration:none;color:#111827" do %>
        <span style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:9px;background:#4F46E5;color:#FFFFFF">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3z"></path><path d="M9 8h6"></path><path d="M9 12h6"></path></svg>
        </span>
        <span style="font-size:17px;font-weight:800;letter-spacing:-0.01em">NICO <span style="font-weight:500;color:#4B5563">Boletas</span></span>
      <% end %>
      <nav style="display:flex;align-items:center;gap:4px">
        <%= link_to "Boletas", boletas_path, style: "display:inline-flex;align-items:center;min-height:44px;padding:0 14px;border-radius:8px;background:#EEF2FF;color:#4338CA;font-size:14px;font-weight:600;text-decoration:none" %>
      </nav>
    </div>
  </header>

  <main style="max-width:1120px;margin:0 auto;padding:40px 24px 64px;box-sizing:border-box;display:flex;flex-direction:column;gap:24px">

    <div style="display:flex;flex-direction:column;gap:12px">
      <nav style="display:flex;align-items:center;gap:6px;font-size:14px;color:#6B7280">
        <%= link_to "Boletas", boletas_path, style: "font-weight:500;text-decoration:none;color:#4F46E5" %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
        <span style="color:#4B5563"><%= @boleta.nombre_comercio.presence || "Boleta ##{@boleta.id}" %></span>
      </nav>
      <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:16px 24px">
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px">
          <h1 style="margin:0;font-size:28px;font-weight:700;letter-spacing:-0.02em;line-height:1.2">
            <%= @boleta.nombre_comercio.presence || "Boleta sin datos" %>
          </h1>
          <%= render "estado_badge", boleta: @boleta %>
        </div>
        <%= link_to "Volver al listado", boletas_path,
            style: "display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 18px;border:1px solid #D1D5DB;border-radius:10px;background:#FFFFFF;color:#111827;font-size:15px;font-weight:600;text-decoration:none" %>
      </div>
    </div>

    <% if notice.present? %>
      <div role="alert" style="display:flex;align-items:center;gap:10px;background:#ECFDF5;border:1px solid #A7F3D0;color:#065F46;border-radius:10px;padding:12px 16px;font-size:14px;font-weight:500">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg>
        <%= notice %>
      </div>
    <% end %>

    <div style="display:flex;flex-wrap:wrap;align-items:flex-start;gap:24px">

      <section style="flex:999 1 560px;min-width:0;background:#FFFFFF;border:1px solid #EEF0F2;border-radius:12px;box-shadow:0 1px 2px rgba(17,24,39,0.04);padding:28px;box-sizing:border-box;display:flex;flex-direction:column;gap:28px">

        <dl style="margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(150px,100%),1fr));gap:24px">
          <div style="display:flex;flex-direction:column;gap:4px">
            <dt style="font-size:13px;font-weight:500;color:#4B5563">Comercio</dt>
            <dd style="margin:0;font-size:16px;font-weight:600"><%= @boleta.nombre_comercio.presence || "—" %></dd>
          </div>
          <div style="display:flex;flex-direction:column;gap:4px">
            <dt style="font-size:13px;font-weight:500;color:#4B5563">RUT</dt>
            <dd style="margin:0;font-size:16px;font-weight:600;font-variant-numeric:tabular-nums"><%= @boleta.rut_comercio.presence || "—" %></dd>
          </div>
          <div style="display:flex;flex-direction:column;gap:4px">
            <dt style="font-size:13px;font-weight:500;color:#4B5563">Fecha</dt>
            <dd style="margin:0;font-size:16px;font-weight:600;font-variant-numeric:tabular-nums">
              <%= @boleta.fecha ? @boleta.fecha.strftime("%d %b %Y") : "—" %>
            </dd>
          </div>
          <div style="display:flex;flex-direction:column;gap:4px">
            <dt style="font-size:13px;font-weight:500;color:#4B5563">Total</dt>
            <dd style="margin:0;font-size:22px;font-weight:700;font-variant-numeric:tabular-nums">
              <% if @boleta.monto_total.present? %>
                $<%= number_with_delimiter(@boleta.monto_total.to_i, delimiter: ".") %>
              <% else %>
                <span style="font-size:16px;font-weight:600;color:#9CA3AF">—</span>
              <% end %>
            </dd>
          </div>
        </dl>

        <% if @boleta.estado == "completado" %>
          <div role="note" style="display:flex;align-items:flex-start;gap:12px;padding:16px 20px;border:1px solid #A7F3D0;border-radius:12px;background:#ECFDF5">
            <span style="flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:999px;background:#D1FAE5;color:#059669">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg>
            </span>
            <div style="display:flex;flex-direction:column;gap:8px">
              <div style="font-size:15px;font-weight:700;color:#065F46">Boleta procesada correctamente</div>
              <div style="font-size:14px;color:#047857">Revisa los datos y corrígelos si es necesario antes de confirmar.</div>
              <%= link_to "Revisar y editar datos", edit_boleta_path(@boleta),
                  style: "display:inline-flex;align-items:center;gap:6px;min-height:36px;padding:0 14px;border-radius:8px;background:#059669;color:#FFFFFF;font-size:14px;font-weight:600;text-decoration:none" %>
            </div>
          </div>
        <% elsif @boleta.estado == "error" %>
          <div role="alert" style="display:flex;align-items:flex-start;gap:12px;padding:16px 20px;border:1px solid #FECACA;border-radius:12px;background:#FEF2F2">
            <span style="flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:999px;background:#FEE2E2;color:#DC2626">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v4"></path><path d="M12 16v.01"></path></svg>
            </span>
            <div style="display:flex;flex-direction:column;gap:8px">
              <div style="font-size:15px;font-weight:700;color:#991B1B">No se pudieron extraer los datos automáticamente</div>
              <div style="font-size:14px;color:#B91C1C">Puedes ingresar los datos manualmente.</div>
              <%= link_to "Ingresar datos manualmente", edit_boleta_path(@boleta),
                  style: "display:inline-flex;align-items:center;gap:6px;min-height:36px;padding:0 14px;border-radius:8px;background:#DC2626;color:#FFFFFF;font-size:14px;font-weight:600;text-decoration:none" %>
            </div>
          </div>
        <% end %>

        <div style="font-size:12px;color:#9CA3AF">
          Registrada <%= time_ago_in_words(@boleta.created_at) %> atrás · ID #<%= @boleta.id %>
        </div>

      </section>

      <aside style="flex:1 1 280px;min-width:0;background:#FFFFFF;border:1px solid #EEF0F2;border-radius:12px;box-shadow:0 1px 2px rgba(17,24,39,0.04);padding:20px;box-sizing:border-box;display:flex;flex-direction:column;gap:14px">
        <h2 style="margin:0;font-size:15px;font-weight:700">Archivo original</h2>
        <%= render "vista_previa", boleta: @boleta %>
      </aside>
    </div>
  </main>
</div>