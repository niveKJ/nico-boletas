<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-slate-800"><%= @boleta.nombre_comercio || "Boleta sin procesar" %></h1>
    <p class="text-slate-500 text-sm mt-1">Subida el <%= @boleta.created_at.strftime("%d/%m/%Y a las %H:%M") %></p>
  </div>
  <div class="flex items-center gap-3">
    <%= render "estado_badge", boleta: @boleta %>
    <%= link_to "Editar", edit_boleta_path(@boleta), class: "text-sm font-medium text-blue-600 hover:text-blue-700" %>
  </div>
</div>

<div class="bg-white border border-slate-200 rounded-2xl p-8 space-y-6">
  <div class="grid grid-cols-2 gap-6">
    <div>
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wide">Comercio</p>
      <p class="text-slate-800 font-semibold mt-1"><%= @boleta.nombre_comercio || "—" %></p>
    </div>
    <div>
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wide">RUT comercio</p>
      <p class="text-slate-800 font-semibold mt-1"><%= @boleta.rut_comercio || "—" %></p>
    </div>
    <div>
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wide">Fecha</p>
      <p class="text-slate-800 font-semibold mt-1"><%= @boleta.fecha&.strftime("%d/%m/%Y") || "—" %></p>
    </div>
    <div>
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wide">Monto total</p>
      <p class="text-2xl font-bold text-slate-800 mt-1">
        <% if @boleta.monto_total %>
          $<%= number_with_delimiter(@boleta.monto_total, delimiter: ".") %>
        <% else %>
          —
        <% end %>
      </p>
    </div>
  </div>

  <% if @boleta.archivo.attached? %>
    <div class="border-t border-slate-100 pt-6">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wide mb-3">Archivo original</p>
      <% if @boleta.archivo.content_type.start_with?("image/") %>
        <%= image_tag url_for(@boleta.archivo), class: "max-w-sm rounded-lg border border-slate-200" %>
      <% else %>
        <a href="<%= url_for(@boleta.archivo) %>" target="_blank" class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 text-sm font-medium">
          📄 Ver PDF
        </a>
      <% end %>
    </div>
  <% end %>
</div>

<div class="mt-4">
  <%= link_to "← Volver al listado", boletas_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
</div>