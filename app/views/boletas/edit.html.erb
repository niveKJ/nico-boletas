<div class="mb-8">
  <h1 class="text-2xl font-bold text-slate-800">Editar boleta</h1>
  <p class="text-slate-500 text-sm mt-1">Corrige los datos extraídos por la IA</p>
</div>

<div class="bg-white border border-slate-200 rounded-2xl p-8">
  <%= form_with model: @boleta, url: boleta_path(@boleta), method: :patch do |f| %>
    <div class="grid grid-cols-2 gap-6">
      <div>
        <%= f.label :nombre_comercio, "Nombre del comercio", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
        <%= f.text_field :nombre_comercio, class: "w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      </div>

      <div>
        <%= f.label :rut_comercio, "RUT del comercio", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
        <%= f.text_field :rut_comercio, class: "w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      </div>

      <div>
        <%= f.label :fecha, "Fecha", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
        <%= f.date_field :fecha, class: "w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      </div>

      <div>
        <%= f.label :monto_total, "Monto total ($)", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
        <%= f.number_field :monto_total, step: "0.01", class: "w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      </div>

      <div>
        <%= f.label :estado, "Estado", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
        <%= f.select :estado, Boleta::ESTADOS.map { |e| [e.capitalize, e] }, {}, class: "w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      </div>
    </div>

    <div class="mt-8 flex items-center justify-between">
      <%= link_to "Cancelar", boleta_path(@boleta), class: "text-sm text-slate-500 hover:text-slate-700" %>
                <%= f.submit "Guardar cambios", class: "bg-blue-600 text-white font-medium px-6 py-2.5 rounded-lg hover:bg-blue-700 transition-colors cursor-pointer" %>
                        </div>
      <% end %>
    </div>