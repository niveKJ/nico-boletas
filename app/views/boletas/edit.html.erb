<%# app/views/boletas/edit.html.erb %>
<div style="min-height:100vh;background:#F8F9FA">

  <%# ── Header ────────────────────────────────────────────── %>
  <header style="background:#FFFFFF;border-bottom:1px solid #E5E7EB">
    <div style="max-width:1120px;margin:0 auto;padding:12px 24px;box-sizing:border-box;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 24px">
      <%= link_to root_path, style: "display:inline-flex;align-items:center;gap:10px;min-height:44px;text-decoration:none;color:#111827" do %>
        <span style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:9px;background:#4F46E5;color:#FFFFFF">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3z"></path><path d="M9 8h6"></path><path d="M9 12h6"></path></svg>
        </span>
        <span style="font-size:17px;font-weight:800;letter-spacing:-0.01em">NICO <span style="font-weight:500;color:#4B5563">Boletas</span></span>
      <% end %>
      <nav aria-label="Principal" style="display:flex;align-items:center;gap:4px">
        <%= link_to "Boletas", boletas_path, style: "display:inline-flex;align-items:center;min-height:44px;padding:0 14px;border-radius:8px;background:#EEF2FF;color:#4338CA;font-size:14px;font-weight:600;text-decoration:none" %>
      </nav>
    </div>
  </header>

  <main style="max-width:1120px;margin:0 auto;padding:40px 24px 64px;box-sizing:border-box;display:flex;flex-direction:column;gap:28px">

    <%# Breadcrumb + título %>
    <div style="display:flex;flex-direction:column;gap:12px">
      <nav aria-label="Ruta" style="display:flex;align-items:center;gap:6px;font-size:14px;color:#6B7280">
        <%= link_to "Boletas", boletas_path, style: "font-weight:500;text-decoration:none;color:#4F46E5" %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
        <span style="color:#4B5563">Revisar boleta</span>
      </nav>
      <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
        <h1 style="margin:0;font-size:28px;font-weight:700;letter-spacing:-0.02em;line-height:1.2">Revisar y confirmar</h1>
        <% if @boleta.estado == "extraido" %>
          <span style="display:inline-flex;align-items:center;gap:5px;background:#EEF2FF;color:#4338CA;font-size:13px;font-weight:600;padding:4px 10px;border-radius:999px">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v4l3 3"></path></svg>
            Datos extraídos por IA
          </span>
        <% elsif @boleta.estado == "error" %>
          <span style="display:inline-flex;align-items:center;gap:5px;background:#FEF2F2;color:#991B1B;font-size:13px;font-weight:600;padding:4px 10px;border-radius:999px">
            ⚠️ Extracción fallida — ingreso manual
          </span>
        <% end %>
      </div>
      <p style="margin:0;font-size:15px;color:#4B5563">Verifica los datos que extrajo la IA, corrige lo que sea necesario y guarda.</p>
    </div>

    <%# Flash alert %>
    <% if alert.present? %>
      <div role="alert" style="display:flex;align-items:center;gap:10px;background:#FEF2F2;border:1px solid #FECACA;color:#991B1B;border-radius:10px;padding:12px 16px;font-size:14px;font-weight:500">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v4"></path><path d="M12 16v.01"></path></svg>
        <%= alert %>
      </div>
    <% end %>

    <%# Errores de validación al guardar %>
    <% if @boleta.errors.any? %>
      <div role="alert" style="background:#FEF2F2;border:1px solid #FECACA;color:#991B1B;border-radius:10px;padding:12px 16px;font-size:14px;font-weight:500">
        No se pudo guardar la boleta:
        <ul style="margin:6px 0 0;padding-left:18px;font-weight:400">
          <% @boleta.errors.full_messages.each do |mensaje| %>
            <li><%= mensaje %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# Formulario y boleta original lado a lado, para comparar al revisar %>
    <div style="display:flex;flex-wrap:wrap;align-items:flex-start;gap:24px">

    <%= form_with model: @boleta, url: boleta_path(@boleta), method: :patch,
        style: "flex:999 1 480px;min-width:0;display:flex;flex-direction:column;gap:20px" do |f| %>

      <div style="background:#FFFFFF;border:1px solid #E5E7EB;border-radius:16px;padding:28px;display:flex;flex-direction:column;gap:20px">

        <%# Nombre del comercio %>
        <div style="display:flex;flex-direction:column;gap:6px">
          <%= f.label :nombre_comercio, "Nombre del comercio",
              style: "font-size:14px;font-weight:600;color:#374151" %>
          <%= f.text_field :nombre_comercio,
              placeholder: "Ej: Supermercado Lider",
              style: "width:100%;box-sizing:border-box;border:1px solid #D1D5DB;border-radius:8px;padding:10px 12px;font-size:15px;color:#111827;background:#FFFFFF;font-family:inherit;outline:none",
              required: true %>
        </div>

        <%# RUT del comercio %>
        <div style="display:flex;flex-direction:column;gap:6px">
          <%= f.label :rut_comercio, "RUT del comercio",
              style: "font-size:14px;font-weight:600;color:#374151" %>
          <%= f.text_field :rut_comercio,
              placeholder: "Ej: 76.543.210-K",
              style: "width:100%;box-sizing:border-box;border:1px solid #D1D5DB;border-radius:8px;padding:10px 12px;font-size:15px;color:#111827;background:#FFFFFF;font-family:inherit;font-variant-numeric:tabular-nums;outline:none" %>
        </div>

        <%# Fecha y Monto en dos columnas %>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
          <div style="display:flex;flex-direction:column;gap:6px">
            <%= f.label :fecha, "Fecha de emisión",
                style: "font-size:14px;font-weight:600;color:#374151" %>
            <%= f.date_field :fecha,
                style: "width:100%;box-sizing:border-box;border:1px solid #D1D5DB;border-radius:8px;padding:10px 12px;font-size:15px;color:#111827;background:#FFFFFF;font-family:inherit;outline:none",
                required: true %>
          </div>
          <div style="display:flex;flex-direction:column;gap:6px">
            <%= f.label :monto_total, "Monto total (CLP)",
                style: "font-size:14px;font-weight:600;color:#374151" %>
            <%= f.number_field :monto_total,
                placeholder: "Ej: 15990",
                min: 1,
                step: 1,
                style: "width:100%;box-sizing:border-box;border:1px solid #D1D5DB;border-radius:8px;padding:10px 12px;font-size:15px;color:#111827;background:#FFFFFF;font-family:inherit;font-variant-numeric:tabular-nums;outline:none",
                required: true %>
          </div>
        </div>

        <%# Items %>
        <div style="display:flex;flex-direction:column;gap:6px">
          <%= f.label :items, "Ítems detectados",
              style: "font-size:14px;font-weight:600;color:#374151" %>
          <p style="margin:0;font-size:13px;color:#6B7280">Un ítem por línea. Puedes editar o agregar.</p>
          <%= f.text_area :items,
              rows: 5,
              placeholder: "Leche entera 1L\nPan molde\n...",
              style: "width:100%;box-sizing:border-box;border:1px solid #D1D5DB;border-radius:8px;padding:10px 12px;font-size:14px;color:#111827;background:#FFFFFF;font-family:inherit;resize:vertical;outline:none" %>
        </div>

      </div>

      <%# Acciones %>
      <div style="display:flex;gap:12px;align-items:center">
        <%= f.submit "Confirmar y guardar",
            style: "flex:1;display:flex;align-items:center;justify-content:center;min-height:52px;border-radius:10px;background:#4F46E5;color:#FFFFFF;font-size:16px;font-weight:600;border:none;cursor:pointer;font-family:inherit;box-shadow:0 1px 2px rgba(79,70,229,0.3)" %>
        <%= link_to "Cancelar", boletas_path,
            style: "display:inline-flex;align-items:center;min-height:52px;padding:0 20px;border-radius:10px;border:1px solid #E5E7EB;background:#FFFFFF;color:#4B5563;font-size:15px;font-weight:500;text-decoration:none" %>
      </div>

    <% end %>

    <aside style="flex:1 1 360px;min-width:0;position:sticky;top:24px;background:#FFFFFF;border:1px solid #E5E7EB;border-radius:16px;padding:20px;box-sizing:border-box;display:flex;flex-direction:column;gap:14px">
      <h2 style="margin:0;font-size:15px;font-weight:700">Boleta original</h2>
      <%= render "vista_previa", boleta: @boleta %>
    </aside>

    </div>

  </main>
</div>
