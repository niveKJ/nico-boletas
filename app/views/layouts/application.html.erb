<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>NICO Boletas</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "tailwind", "data-turbo-track": "reload" %>
  </head>

  <body class="bg-slate-50 min-h-screen font-sans">
    <nav class="bg-white border-b border-slate-200 px-6 py-4">
      <div class="max-w-4xl mx-auto flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <span class="text-blue-600 font-bold text-xl">NICO</span>
          <span class="text-slate-500 text-sm font-medium">Boletas</span>
        </a>
        <%= link_to "Nueva boleta", new_boleta_path, class: "bg-blue-600 text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors" %>
      </div>
    </nav>

    <main class="max-w-4xl mx-auto px-6 py-8">
      <% if notice %>
        <div class="mb-6 bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg text-sm">
          <%= notice %>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>